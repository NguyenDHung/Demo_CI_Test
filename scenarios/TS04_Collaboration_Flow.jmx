            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">vars.put(&quot;email&quot;, vars.get(&quot;owner_email&quot;));
vars.put(&quot;password&quot;, vars.get(&quot;owner_password&quot;));</stringProp>
