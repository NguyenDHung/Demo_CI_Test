        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
      </ConfigTestElement>
      <hashTree/>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="ROLE_ID" elementType="Argument">
            <stringProp name="Argument.name">ROLE_ID</stringProp>
            <stringProp name="Argument.value">135ee355-ff35-45ef-98ff-654166770f7b</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setUp Thread Group" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import org.apache.jmeter.services.FileServer
import java.io.File

// Xác định thư mục data/ dựa trên vị trí file .jmx hiện tại
String baseDir = FileServer.getFileServer().getBaseDir()
File dataDir = new File(baseDir, &quot;../data&quot;)
File usersFile = new File(dataDir, &quot;users.csv&quot;)
File pairsFile = new File(dataDir, &quot;collaboration_pairs.csv&quot;)

if (!usersFile.exists()) {
    log.error(&quot;Không tìm thấy file users.csv tại: &quot; + usersFile.getAbsolutePath())
    return
}

// Đọc file users, bỏ qua dòng tiêu đề và dòng trống
def lines = usersFile.readLines().findAll { it.trim() &amp;&amp; !it.startsWith(&quot;email&quot;) }
def pairs = []
pairs &lt;&lt; &quot;owner_email,owner_password,collab_email,collab_password&quot;

int pairCount = 20
for (int i = 0; i &lt; pairCount &amp;&amp; (i + pairCount) &lt; lines.size(); i++) {
    def owner = lines[i].split(&quot;,&quot;)
    def collab = lines[i + pairCount].split(&quot;,&quot;)
    pairs &lt;&lt; &quot;${owner[0].trim()},${owner[1].trim()},${collab[0].trim()},${collab[1].trim()}&quot;
}

// Ghi file mới
pairsFile.text = pairs.join(&quot;\n&quot;)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Thread Group">
        <intProp name="ThreadGroup.num_threads">40</intProp>
        <intProp name="ThreadGroup.ramp_time">40</intProp>
        <longProp name="ThreadGroup.duration">240</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
